let ilhaAtual = null;
let stepAtual = null;

function abrirIlha(id) {
  const ilha = ilhasData[id];
  if (!ilha) return;
  ilhaAtual = id;
  document.getElementById('ipop').classList.remove('on');

  // island colours by id
  const cols = {
    1: { top:'#34D399', hl:'#6EE7B7', base:'#1a6b47', conn:'#34D399', label:'Início' },
    2: { top:'#F59E0B', hl:'#FDE68A', base:'#7C4B20', conn:'#F59E0B', label:'Nível 1' },
    3: { top:'#D4A574', hl:'#E8C99A', base:'#7C4B20', conn:'#D4A574', label:'Nível 2' },
  };
  const col = cols[id] || cols[2];

  // header
  document.getElementById('ilhaNome').textContent = ilha.nome;
  document.getElementById('ilhaLabelSub').textContent = col.label;
  document.getElementById('ilhaLabelName').textContent = ilha.nome.replace(/^[①②③] /, '');

  const done = ilha.steps.filter(s=>s.done).length;
  const total = ilha.steps.length;
  document.getElementById('ilhaProgHUD').textContent = done + '/' + total + ' desafios';

  // update SVG colours
  ['mainRect','connRect','topRect'].forEach(id2 => {
    const el = document.getElementById(id2);
    if(el) el.setAttribute('fill', col.top);
  });
  ['mainHL','topRect2'].forEach(id2 => {
    const el = document.getElementById(id2);
    if(el) el.setAttribute('fill', col.hl);
  });

  // render steps path on island SVG
  // positions for up to 7 steps arranged in a zigzag path across the two-piece island
  const stepPos = [
    {x:60,  y:370}, // 1 bottom-left
    {x:60,  y:300}, // 2 mid-left
    {x:180, y:270}, // 3 mid-center
    {x:300, y:300}, // 4 mid-right
    {x:300, y:230}, // 5 upper-right (connector area)
    {x:220, y:140}, // 6 top piece right
    {x:160, y:60},  // 7 top piece top
  ];

  const steps = ilha.steps.slice(0, 7);
  const pts = stepPos.slice(0, steps.length);

  // build polyline
  const polyPts = pts.map(p => p.x+','+p.y).join(' ');

  let svg = '';
  // white path
  svg += `<polyline points="${polyPts}" fill="none" stroke="white" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>`;
  // step dots
  steps.forEach((s, i) => {
    const p = pts[i];
    const isDone = s.done;
    const isActive = s.active && !s.done;
    const isLocked = !s.done && !s.active;
    const fill = isDone ? '#71C8C0' : isActive ? '#FBC92A' : 'white';
    const stroke = isDone ? '#1a6b47' : isActive ? '#D97706' : '#CBD5E1';
    const r = isActive ? 18 : 15;
    const canOpen = (isDone || isActive) && s.emo;
    const gOpen = canOpen ? ` style="cursor:pointer" onclick="abrirDesafio(${ilhaAtual},${s.n})"` : '';
    svg += `<g${gOpen}>`;
    // larger invisible hit area for easy clicking
    if (canOpen) svg += `<circle cx="${p.x}" cy="${p.y}" r="${r+10}" fill="transparent"/>`;
    svg += `<circle cx="${p.x}" cy="${p.y}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="3"/>`;
    if (isDone) {
      svg += `<text x="${p.x}" y="${p.y+6}" text-anchor="middle" font-size="14" fill="#012C56" font-family="Arial" font-weight="800" style="pointer-events:none">✓</text>`;
    } else if (!isLocked) {
      svg += `<text x="${p.x}" y="${p.y+5}" text-anchor="middle" font-size="13" fill="${isActive?'#7C2D12':'#94a3b8'}" font-family="Arial" font-weight="800" style="pointer-events:none">${i+1}</text>`;
    } else {
      svg += `<text x="${p.x}" y="${p.y+5}" text-anchor="middle" font-size="13" fill="#CBD5E1" font-family="Arial" font-weight="600" style="pointer-events:none">${i+1}</text>`;
    }
    svg += `</g>`;
  });

  // decorations based on island
  let deco = '';
  if (id === 1 || id === 2) {
    // palm tree
    deco += `<rect x="140" y="290" width="9" height="35" rx="3" fill="#7C4B20"/>`;
    deco += `<ellipse cx="144" cy="286" rx="22" ry="10" fill="#16A34A" transform="rotate(-22 144 286)"/>`;
    deco += `<ellipse cx="144" cy="287" rx="22" ry="10" fill="#22C55E" transform="rotate(22 144 287)"/>`;
    deco += `<ellipse cx="144" cy="288" rx="18" ry="8" fill="#16A34A" transform="rotate(65 144 288)"/>`;
  }
  if (id === 2) {
    // 2nd palm on top piece
    deco += `<rect x="172" y="25" width="7" height="24" rx="2" fill="#7C4B20"/>`;
    deco += `<ellipse cx="175" cy="21" rx="17" ry="8" fill="#16A34A" transform="rotate(-22 175 21)"/>`;
    deco += `<ellipse cx="175" cy="22" rx="17" ry="8" fill="#22C55E" transform="rotate(22 175 22)"/>`;
  }
  if (id === 3) {
    // pine trees
    deco += `<rect x="138" y="290" width="8" height="28" rx="2" fill="#7C4B20"/>`;
    deco += `<polygon points="142,255 126,292 158,292" fill="#166534"/>`;
    deco += `<polygon points="142,268 128,298 156,298" fill="#22C55E"/>`;
    deco += `<rect x="200" y="25" width="7" height="22" rx="2" fill="#7C4B20"/>`;
    deco += `<polygon points="203,0 188,28 218,28" fill="#166534"/>`;
    deco += `<polygon points="203,12 190,34 216,34" fill="#22C55E"/>`;
    // rocks
    deco += `<ellipse cx="245" cy="250" rx="16" ry="10" fill="#A0856A"/>`;
    deco += `<ellipse cx="260" cy="246" rx="12" ry="9" fill="#B8977E"/>`;
  }

  document.getElementById('stepsGroup').innerHTML = svg;
  document.getElementById('decoGroup').innerHTML = deco;

  // show/hide top piece (only for islands with 7 steps)
  const showTop = steps.length >= 5;
  ['topPiece'].forEach(id2 => {
    const el = document.getElementById(id2);
    if(el) el.style.display = showTop ? 'block' : 'none';
  });
  const conn = document.getElementById('connRect');
  if(conn) conn.style.display = showTop ? 'block' : 'none';
  const connB = document.getElementById('connBase');
  if(connB) connB.style.display = showTop ? 'block' : 'none';

  // steps list cards below
  const list = document.getElementById('stepsList');
  list.innerHTML = ilha.steps.map((s,i) => {
    const isDone = s.done;
    const isActive = s.active && !s.done;
    const isLocked = !s.done && !s.active;
    const bg = isDone ? 'rgba(49,192,107,.15)' : isActive ? 'rgba(251,201,42,.15)' : 'rgba(255,255,255,.07)';
    const border = isDone ? 'rgba(49,192,107,.4)' : isActive ? 'rgba(251,201,42,.4)' : 'rgba(255,255,255,.1)';
    const numBg = isDone ? '#71C8C0' : isActive ? '#FBC92A' : 'rgba(255,255,255,.15)';
    const numCol = isDone ? '#012C56' : isActive ? '#7C2D12' : 'rgba(255,255,255,.35)';
    const clickable = (isDone || isActive) && s.emo;
    const onclk = clickable ? 'onclick="abrirDesafio(' + ilhaAtual + ',' + s.n + ')"' : '';
    const numTxt = isDone ? '&#10003;' : s.n;
    const hover = clickable
      ? ' onmouseover="this.style.transform=\'translateX(5px)\'" onmouseout="this.style.transform=\'none\'"'
      : '';
    const tag = isDone
      ? '<div style="font-size:11px;font-weight:800;color:#86efac;font-family:Outfit,sans-serif;display:flex;align-items:center;gap:4px;white-space:nowrap">↻ Repetir</div>'
      : isActive
      ? '<div style="font-size:11px;font-weight:800;color:#FBC92A;font-family:Outfit,sans-serif;white-space:nowrap">▶ Jogar</div>'
      : '<div style="font-size:16px">🔒</div>';
    return '<div ' + onclk + hover + ' style="background:' + bg + ';border:1px solid ' + border + ';border-radius:14px;padding:13px 15px;display:flex;align-items:center;gap:12px;cursor:' + (clickable?'pointer':'default') + ';transition:transform .15s ease"'+'>'
      + '<div style="width:36px;height:36px;border-radius:50%;background:' + numBg + ';display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:' + numCol + ';flex-shrink:0">' + numTxt + '</div>'
      + '<div style="flex:1"><div style="font-size:14px;font-weight:700;color:white">' + s.titulo + '</div>'
      + '<div style="font-size:11px;color:rgba(255,255,255,.55);font-family:Quicksand,sans-serif;margin-top:2px">' + s.desc + '</div></div>'
      + tag
      + '</div>';
  }).join('');
  shV('v-ilha');
}


function goMap() {
  const lv = Lvs[cLvl];
  const el = id => document.getElementById(id);
  if(el('mCN')) el('mCN').textContent = uName;
  if(el('mLv')) el('mLv').textContent = lv.lv;
  if(el('mXP')) el('mXP').textContent = lv.xp;
  if(el('mXF')) el('mXF').style.width = lv.xpF;
  if(el('mC'))  el('mC').textContent = lv.coins;
  if(el('mS'))  el('mS').textContent = lv.streak;
  if(el('i2p')) el('i2p').textContent = lv.i2;
  if(cLvl >= 2) { const i3=document.getElementById('i3'); if(i3) i3.classList.remove('lk'); }
  document.querySelectorAll('.ni').forEach(b=>b.classList.remove('on'));
  const mb = document.querySelector('.ni[onclick*="v-map"]');
  if(mb) mb.classList.add('on');
  shV('v-map');
  // Posição inicial — mostrar a zona de início (Diagnóstico + Principal)
  requestAnimationFrame(() => {
    mapPan.x = 0;
    mapPan.y = 0;
    clampMapPan();
    applyMapPan();
  });
}

function voltarIlha() {
  if (ilhaAtual) abrirIlha(ilhaAtual);
  else goMap();
}

