      {kind:"block",type:"juni_math", inputs:{A:numSh(1),B:numSh(1)}},
      {kind:"block",type:"juni_compare", inputs:{A:numSh(1),B:numSh(1)}},
      {kind:"block",type:"juni_logic"},
      {kind:"block",type:"juni_not"},
      {kind:"block",type:"juni_random", inputs:{A:numSh(1),B:numSh(10)}},
    ]},
    {kind:"category", name:"Variáveis", colour:"#FF8C1A", custom:"VARIABLE"},
  ]
};

function initBlockly(){
  if(blocklyWS || typeof Blockly === 'undefined') return;
  try {
    Blockly.defineBlocksWithJsonArray(JUNI_BLOCKS);
    const juniTheme = Blockly.Theme.defineTheme('juni', {
      base: Blockly.Themes.Classic,
      componentStyles: {
        workspaceBackgroundColour: '#1e1e2e',
        toolboxBackgroundColour: '#12122a',
        toolboxForegroundColour: '#e2e8f0',
        flyoutBackgroundColour: '#181826',
        flyoutForegroundColour: '#cbd5e1',
        flyoutOpacity: 1,
        scrollbarColour: '#3a3a55',
        scrollbarOpacity: 0.6,
        insertionMarkerColour: '#71C8C0',
        insertionMarkerOpacity: 0.5,
        cursorColour: '#71C8C0',
      }
    });
    blocklyWS = Blockly.inject('blocklyDiv', {
      toolbox: JUNI_TOOLBOX,
      renderer: 'zelos',
      theme: juniTheme,
      scrollbars: true,
      trashcan: true,
      sounds: false,
      grid: { spacing:30, length:2, colour:'#2a3a5f', snap:true },
      zoom: { controls:true, wheel:false, startScale:0.85, maxScale:1.5, minScale:0.5 },
      move: { scrollbars:true, drag:true, wheel:true },
    });
  } catch(e){ console.warn('Blockly init falhou:', e); }
}

function seedStartBlock(){
  if(!blocklyWS) return;
  try {
    Blockly.serialization.workspaces.load(
      { blocks: { blocks: [ { type:'juni_start', x:50, y:40 } ] } },
      blocklyWS
    );
  } catch(e){ try{ blocklyWS.clear(); }catch(e2){} }
}

function abrirDesafio(ilhaId, stepN) {
  const ilha = ilhasData[ilhaId];
  const step = ilha.steps.find(s => s.n === stepN);
  if (!step || !step.emo) return;
  stepAtual = step;
  ilhaAtual = ilhaId;

  // header
  document.getElementById('desTitle').textContent = 'Desafio ' + stepN + ' — ' + step.titulo;

  // progress dots
  const dots = ilha.steps.map((s,i) =>
    `<div style="width:10px;height:10px;border-radius:50%;background:${s.done?'#71C8C0':s.active?'#FBC92A':'rgba(255,255,255,.2)'}"></div>`
  ).join('');
  document.getElementById('desProg').innerHTML = dots;

  // instruction
  document.getElementById('desEmoji').textContent = step.emo;
  document.getElementById('desH3').textContent = step.titulo + '!';
  document.getElementById('desP').textContent = step.inst;

  // robot txt
  document.getElementById('robotTxt').textContent = 'pronto!';

  // output message
  document.getElementById('desOutput').querySelector('p').textContent = step.output || 'Clica ▶ para executar';

  shV('v-desafio');

  // Editor de blocos Scratch — injeta (1ª vez) e prepara um bloco de início
  requestAnimationFrame(() => {
    initBlockly();
    seedStartBlock();
    if(blocklyWS){
      Blockly.svgResize(blocklyWS);
      setTimeout(() => { if(blocklyWS) Blockly.svgResize(blocklyWS); }, 120);
    }
  });
}

function runCode(btn) {
  if (!stepAtual) return;
  btn = btn || document.querySelector('#v-desafio button[onclick*="runCode"]');
  if(!btn) return;
  // É preciso ter montado algum bloco para além do "quando começar"
  if(blocklyWS && blocklyWS.getAllBlocks(false).length < 2){
    document.getElementById('desOutput').innerHTML = `
      <div style="text-align:center;width:100%">
        <div style="font-size:42px;margin-bottom:8px">🧩</div>
        <div style="font-size:15px;font-weight:900;color:#FBC92A;margin-bottom:5px">Monta o teu programa!</div>
        <div style="font-size:12px;color:#7dd3fc;font-family:'Quicksand',sans-serif;line-height:1.5">Arrasta blocos da paleta e encaixa-os por baixo de "quando começar".</div>
      </div>`;
    return;
  }
  btn.textContent = '⟳ A correr...';
  btn.style.background = '#5fb8b0';
  setTimeout(() => {
    btn.textContent = '▶ Correr';
    btn.style.background = '#71C8C0';
    if (stepAtual.robotTxt) document.getElementById('robotTxt').textContent = stepAtual.robotTxt;
    // show success
    document.getElementById('desOutput').innerHTML = `
      <div style="text-align:center;width:100%">
        <div style="font-size:52px;margin-bottom:10px;animation:pop .4s ease">🎉</div>
        <div style="font-size:16px;font-weight:900;color:#71C8C0;margin-bottom:6px">Funcionou!</div>
        <div style="font-size:13px;color:#7dd3fc;font-family:'Quicksand',sans-serif;margin-bottom:16px">${stepAtual.titulo} concluído com sucesso!</div>
        <button onclick="completarDesafio()" style="background:#FBC92A;color:#012C56;border:none;padding:11px 22px;border-radius:10px;font-family:'Outfit',sans-serif;font-weight:900;font-size:14px;cursor:pointer">Próximo desafio →</button>
      </div>`;
  }, 1500);
}

function showHint() {
  alert('💡 Dica: Verifica se a placa Juni:bit está ligada ao computador e se o sensor está no pin correto!');
}

function completarDesafio() {
  // mark as done and go back to ilha
  if (stepAtual && ilhaAtual) {
    const ilha = ilhasData[ilhaAtual];
    const step = ilha.steps.find(s => s.n === stepAtual.n);
    if (step) { step.done = true; step.active = false; }
    // activate next step
    const next = ilha.steps.find(s => !s.done && !s.active && s.emo);
    if (next) next.active = true;
    abrirIlha(ilhaAtual);
  }
}

</script>
