<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Junicoders · Plataforma</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/blockly@11/blockly.min.js"></script>
<style>
/* Paleta oficial Junicoders — Manual de Normas Gráficas */
:root{
  --blue:#0364DB;   /* Azul Vibrante — cor institucional */
  --bd:#012C56;     /* Azul Escuro — substitui o preto */
  --mint:#71C8C0;   /* Verde Menta — cor de acento principal */
  --ml:#7DDEF4;     /* secundária — azul claro da mascote */
  --yel:#FBC92A;    /* Amarelo Solar */
  --grn:#71C8C0;    /* sucesso → Verde Menta (paleta da marca) */
  --red:#EC6C3B;    /* alerta → Laranja Quente (paleta da marca) */
  --org:#EC6C3B;    /* Laranja Quente */
  --bei:#F8F3E0;    /* Bege Areia */
  --sky:#92D6FF;    /* secundária — azul céu */
  --blue2:#1E99F7;  /* secundária — azul brilhante */
  --blue3:#0469BC;  /* secundária — azul médio */
  --mut:#5b6b82;    /* texto secundário (azul dessaturado) */
  --bdr:#dbe3ec     /* contornos neutros */
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Outfit',sans-serif;background:#0364DB;min-height:100vh;overflow-x:hidden}
/* layers */
#SA{display:block}#SA.h{display:none}
#PA{display:none}#PA.on{display:block;background:#f1f5f9;min-height:100vh}
/* blobs */
.bb{position:fixed;border-radius:50%;filter:blur(80px);opacity:.28;animation:bf ease-in-out infinite alternate;pointer-events:none;z-index:0}
@keyframes bf{from{transform:translateY(0)}to{transform:translateY(-26px)}}
.fi{position:absolute;opacity:.1;animation:fiu linear infinite;pointer-events:none}
@keyframes fiu{from{transform:translateY(110vh) rotate(0)}to{transform:translateY(-10vh) rotate(360deg)}}
/* topbar */
.tb{position:fixed;top:0;left:0;right:0;z-index:100;padding:11px 26px;display:flex;align-items:center;background:rgba(1,44,86,.55);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.1)}
.logo{font-weight:900;font-size:20px;color:var(--bei);display:flex;align-items:center;gap:9px;text-decoration:none}
.li{width:35px;height:35px;background:var(--blue);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:18px;border:1.5px solid rgba(255,255,255,.25)}
.logo span{color:var(--mint)}
/* card */
.card-old{position:relative;z-index:10;background:white;border-radius:24px;width:100%;max-width:520px;margin:80px auto 40px;box-shadow:0 28px 70px rgba(1,44,86,.35);overflow:hidden}
.ch{padding:24px 28px 16px;background:var(--bd)}
.ch h1{font-size:21px;font-weight:900;color:white;margin-bottom:3px}
.ch p{font-size:13px;color:var(--ml);font-family:'Quicksand',sans-serif}
.tabs{display:flex;gap:4px;margin-top:14px;background:rgba(255,255,255,.08);border-radius:10px;padding:4px}
.tab{flex:1;padding:8px;border:none;border-radius:7px;font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;cursor:pointer;color:rgba(255,255,255,.5);background:transparent;transition:all .2s}
.tab.on{background:white;color:var(--bd)}
.cb{padding:24px 28px 28px}
/* panels */
.pnl{display:none}.pnl.on{display:block}
/* steps bar */
.sbar{display:flex;gap:5px;margin-bottom:18px}
.sd{height:5px;flex:1;border-radius:3px;background:#e2e8f0;transition:background .3s}
.sd.d{background:var(--grn)}.sd.a{background:var(--blue)}
/* role cards */
.rg{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px}
.rc{border:2.5px solid #e2e8f0;border-radius:16px;padding:18px 14px;cursor:pointer;text-align:center;transition:all .2s;background:white}
.rc:hover{border-color:var(--blue)}.rc.on{border-color:var(--blue);background:#eff6ff}
.ri{width:60px;height:60px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:30px;margin:0 auto 9px}
.rc h3{font-size:14px;font-weight:800;color:var(--bd);margin-bottom:3px}
.rc p{font-size:11px;color:#94a3b8;font-family:'Quicksand',sans-serif;line-height:1.4}
/* form */
.f{margin-bottom:13px}
.f label{display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}
.inp{width:100%;padding:11px 14px;border:2px solid #e2e8f0;border-radius:10px;font-family:'Outfit',sans-serif;font-size:14px;color:#1e293b;outline:none;transition:border-color .2s;background:#f8fafc}
.inp:focus{border-color:var(--blue);background:white}.inp::placeholder{color:#94a3b8}.inp.er{border-color:var(--red)}
.em{display:none;font-size:11px;color:var(--red);margin-top:4px;font-family:'Quicksand',sans-serif}.em.on{display:block}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.pw{position:relative}.pw .inp{padding-right:40px}
.eye{position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:15px;color:#94a3b8}
/* pw bars */
.pbs{display:flex;gap:4px;margin-top:7px}.pb{height:4px;flex:1;border-radius:2px;background:#e2e8f0;transition:background .3s}
.pl{font-size:11px;color:#94a3b8;font-family:'Quicksand',sans-serif;margin-top:3px}
/* divider */
.dv{display:flex;align-items:center;gap:10px;margin:14px 0}
.dv::before,.dv::after{content:'';flex:1;height:1px;background:#e2e8f0}
.dv span{font-size:11px;color:#94a3b8;font-weight:600;white-space:nowrap}
/* social */
.sbs{display:flex;gap:8px;margin-bottom:4px}
.sb{flex:1;padding:9px;border-radius:10px;border:2px solid #e2e8f0;background:white;display:flex;align-items:center;justify-content:center;gap:7px;font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;cursor:pointer;color:#374151;transition:all .2s}
.sb:hover{border-color:var(--blue)}
.si{width:19px;height:19px}
/* buttons */
.bp{width:100%;padding:13px;border:none;border-radius:11px;background:var(--blue);color:white;font-family:'Outfit',sans-serif;font-weight:900;font-size:15px;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px;margin-top:5px}
.bp:hover{background:#0255c0;transform:translateY(-1px);box-shadow:0 8px 20px rgba(3,100,219,.28)}
.arr{transition:transform .2s}.bp:hover .arr{transform:translateX(4px)}
/* Login button — Verde Menta (paleta da marca), estilo Apple */
.bp-login{background:linear-gradient(180deg,#7FD3CB 0%,#62BDB4 100%);color:#012C56;border-radius:14px;padding:15px 20px;font-weight:800;font-size:16px;letter-spacing:-0.01em;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 1px 2px rgba(0,0,0,.08),0 4px 14px rgba(113,200,192,.4);transition:transform .12s cubic-bezier(.2,.8,.2,1),box-shadow .2s ease,background .2s ease;-webkit-tap-highlight-color:transparent}
.bp-login:hover{background:linear-gradient(180deg,#8BDAD2 0%,#6CC6BD 100%);transform:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 1px 2px rgba(0,0,0,.08),0 6px 18px rgba(113,200,192,.5)}
.bp-login:active{transform:scale(.97);transition-duration:.06s;box-shadow:inset 0 1px 2px rgba(0,0,0,.15),0 1px 2px rgba(0,0,0,.08)}
.bp-login:focus-visible{outline:none;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 0 0 4px rgba(113,200,192,.45),0 4px 14px rgba(113,200,192,.4)}
.bp-login .arr{transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.bp-login:hover .arr{transform:translateX(3px)}
/* Login mode toggle (Adulto / Criança) */
.lt{display:flex;background:#f1f5f9;border-radius:10px;padding:3px;gap:2px;margin-bottom:14px}
.lt button{flex:1;border:none;background:transparent;padding:9px 10px;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:600;font-size:13px;color:#64748b;cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:6px}
.lt button:hover{color:#0f172a}
.lt button.on{background:white;color:#012C56;box-shadow:0 1px 2px rgba(0,0,0,.05),0 1px 3px rgba(0,0,0,.08)}
.lt button svg{width:16px;height:16px;flex-shrink:0}
.bk{background:none;border:none;color:var(--blue);font-weight:700;font-size:13px;cursor:pointer;font-family:'Outfit',sans-serif;margin-top:11px;display:block;text-align:center}
.terms{text-align:center;font-size:11px;color:#94a3b8;font-family:'Quicksand',sans-serif;margin-top:11px;line-height:1.6}
.terms a{color:var(--blue);text-decoration:none;font-weight:600}
.sl{text-align:center;font-size:13px;color:#64748b;font-family:'Quicksand',sans-serif;margin-top:14px}
.sl a{color:var(--blue);font-weight:700;text-decoration:none;cursor:pointer}
/* success */
.sw{text-align:center;padding:8px 0}
.be{font-size:66px;display:block;margin-bottom:11px;animation:pop .5s ease}
@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}
.sw h2{font-size:21px;font-weight:900;color:var(--bd);margin-bottom:5px}
.sw p{font-size:13px;color:#64748b;font-family:'Quicksand',sans-serif;margin-bottom:18px;line-height:1.6}
.rcs{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:20px}
.rcc{background:#f1f5f9;border-radius:11px;padding:10px 14px;text-align:center}
.rci{font-size:20px;margin-bottom:2px}.rcl{font-size:10px;color:#64748b;font-weight:600}
.bg{display:inline-block;padding:13px 28px;background:var(--mint);color:var(--bd);border:none;border-radius:12px;font-family:'Outfit',sans-serif;font-weight:900;font-size:15px;cursor:pointer;transition:all .2s}
.bg:hover{background:#5fb8b0;transform:translateY(-1px)}

/* ═══════ PLATFORM ═══════ */
.ps{display:flex;min-height:100vh}
/* sidebar */
.side{width:220px;background:var(--bd);position:fixed;top:0;left:0;bottom:0;z-index:50;display:flex;flex-direction:column;overflow-y:auto}
.sl2{padding:16px 14px 13px;display:flex;align-items:center;gap:9px;border-bottom:1px solid rgba(255,255,255,.08)}
.slo{font-weight:900;font-size:15px;color:var(--bei)}.slo span{color:var(--mint)}
.si2{width:30px;height:30px;background:var(--blue);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px}
.su{padding:11px 13px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:9px}
.sav{width:36px;height:36px;border-radius:50%;background:var(--yel);display:flex;align-items:center;justify-content:center;font-size:19px;flex-shrink:0}
.sn{font-size:13px;font-weight:700;color:white;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sr{font-size:11px;color:var(--ml);font-family:'Quicksand',sans-serif}
.snav{padding:9px 7px;flex:1}
.ns{font-size:10px;color:rgba(255,255,255,.3);font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:9px 8px 5px}
.ni{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:9px;cursor:pointer;transition:all .2s;margin-bottom:2px;color:rgba(255,255,255,.6);font-size:13px;font-weight:600;border:none;background:none;width:100%;text-align:left}
.ni:hover{background:rgba(255,255,255,.08);color:white}.ni.on{background:var(--blue);color:white}
.ni .ico{font-size:16px;flex-shrink:0}
.sbot{padding:11px 9px;border-top:1px solid rgba(255,255,255,.08)}
.lo{width:100%;padding:9px;border:1.5px solid rgba(255,255,255,.15);border-radius:9px;background:none;color:rgba(255,255,255,.6);font-family:'Outfit',sans-serif;font-weight:600;font-size:13px;cursor:pointer;transition:all .2s}
.lo:hover{border-color:var(--red);color:var(--red)}
/* main */
.pm{margin-left:220px;flex:1;padding:26px;background:#f1f5f9;min-height:100vh}
.pv{display:none!important}.pv.on{display:block!important}#v-map.pv.on,#v-diag.pv.on,#v-ilha.pv.on,#v-desafio.pv.on{display:flex!important;flex-direction:column;min-height:0}
.pt{font-size:21px;font-weight:900;color:var(--bd);margin-bottom:3px}
.ps2{font-size:13px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-bottom:20px}
/* stat row */
.sr2{display:grid;gap:13px;margin-bottom:18px}
.c4{grid-template-columns:repeat(4,1fr)}.c3{grid-template-columns:repeat(3,1fr)}
.sc{background:white;border-radius:14px;padding:16px 18px;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.sci{font-size:25px;margin-bottom:5px}.scv{font-size:26px;font-weight:900;color:var(--bd)}.scl{font-size:12px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-top:2px}
/* section card */
.sec{background:white;border-radius:14px;padding:18px 20px;box-shadow:0 1px 4px rgba(0,0,0,.06);margin-bottom:16px}
.sh{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:8px}
.st{font-size:14px;font-weight:800;color:var(--bd)}
.bsm{padding:7px 14px;border-radius:8px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;cursor:pointer;transition:all .2s;border:none;white-space:nowrap}
.bb2{background:var(--blue);color:white}.bb2:hover{background:#0255c0}
.bo{background:none;border:2px solid #e2e8f0;color:var(--bd)}.bo:hover{border-color:var(--blue);color:var(--blue)}
.by{background:#fef9c3;color:#854d0e}
/* prog */
.pb2{height:6px;background:#e2e8f0;border-radius:3px;overflow:hidden;margin-bottom:3px}
.pf{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--grn),var(--mint))}
.pt2{font-size:11px;color:var(--mut);font-family:'Quicksand',sans-serif}
/* badge */
.badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700}
.bd{background:#dcfce7;color:#166534}.bp2{background:#dbeafe;color:#1e40af}.bl{background:#f1f5f9;color:#94a3b8}
/* child cards */
.cg{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:13px}
.cc{background:white;border-radius:14px;padding:16px;box-shadow:0 1px 4px rgba(0,0,0,.06);border:2px solid transparent;cursor:pointer;transition:all .2s}
.cc:hover{border-color:var(--blue);transform:translateY(-2px)}
.cc.add{border:2.5px dashed #cbd5e1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:155px;gap:9px;color:#94a3b8}
.cc.add:hover{border-color:var(--blue);color:var(--blue)}
.cav{width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:9px}
.cn{font-size:14px;font-weight:800;color:var(--bd)}.ca{font-size:12px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-bottom:9px}
.cas{display:flex;gap:6px;margin-top:11px}
.cas button{flex:1;padding:6px;border-radius:7px;font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;cursor:pointer;border:none}
/* island prog */
.il{display:flex;flex-direction:column;gap:9px}
.ii{background:#f8fafc;border-radius:11px;padding:13px 15px;display:flex;align-items:center;gap:13px;border:1.5px solid #e2e8f0}
.iico{font-size:24px;flex-shrink:0}
.iname{font-size:13px;font-weight:700;color:var(--bd)}
.istep{font-size:11px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-top:2px}
/* activity */
.al{display:flex;flex-direction:column;gap:7px}
.ai{display:flex;align-items:center;gap:11px;padding:11px 13px;background:#f8fafc;border-radius:9px}
.aico{font-size:21px;flex-shrink:0}
.att{font-size:13px;font-weight:700;color:var(--bd)}.atm{font-size:11px;color:var(--mut);font-family:'Quicksand',sans-serif}
.axp{font-size:12px;font-weight:700;color:var(--grn)}
/* class list */
.cl{display:flex;flex-direction:column;gap:9px}
.ci{background:#f8fafc;border-radius:13px;padding:15px 17px;border:1.5px solid #e2e8f0;display:flex;align-items:center;gap:14px;cursor:pointer;transition:all .2s}
.ci:hover{border-color:var(--blue);background:#eff6ff}
.cii{width:44px;height:44px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0}
.cin{font-size:14px;font-weight:800;color:var(--bd)}.cim{font-size:12px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-top:2px}
/* table */
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;font-size:11px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.05em;padding:7px 11px;border-bottom:2px solid #e2e8f0}
.tbl td{padding:11px 11px;border-bottom:1px solid #f1f5f9;font-size:13px;color:var(--bd)}
.tbl tr:hover td{background:#f8fafc}
.sav2{width:30px;height:30px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:16px;margin-right:7px;vertical-align:middle}
/* challenge editor */
.cel{display:flex;flex-direction:column;gap:9px}
.ced{background:#f8fafc;border-radius:13px;padding:15px 17px;border:1.5px solid #e2e8f0}
.ceh{display:flex;align-items:center;justify-content:space-between;margin-bottom:9px;gap:7px}
.ceti{font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;color:var(--bd);border:none;background:transparent;outline:none;flex:1}
.ceti:focus{background:#fff;border-bottom:2px solid var(--blue);padding-bottom:2px}
.cede{font-family:'Quicksand',sans-serif;font-size:13px;color:#64748b;width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:7px 11px;resize:none;outline:none;min-height:55px}
.cede:focus{border-color:var(--blue)}
.cem{display:flex;gap:7px;margin-top:9px;align-items:center;flex-wrap:wrap}
.ct{padding:3px 11px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:none;font-family:'Outfit',sans-serif}
.cti{background:#dbeafe;color:#1e40af}.ctd{background:#fef9c3;color:#854d0e}
.add{border:2.5px dashed #cbd5e1;border-radius:13px;padding:15px;text-align:center;cursor:pointer;color:#94a3b8;font-weight:700;font-size:14px;transition:all .2s}
.add:hover{border-color:var(--blue);color:var(--blue)}
/* notif dot */
.nd{width:7px;height:7px;border-radius:50%;background:var(--red);margin-left:auto;flex-shrink:0}
/* modal */
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:200;align-items:center;justify-content:center;padding:18px}
.mo.on{display:flex}
.md{background:white;border-radius:18px;padding:26px;max-width:420px;width:100%;box-shadow:0 28px 70px rgba(0,0,0,.2)}
.md h3{font-size:17px;font-weight:900;color:var(--bd);margin-bottom:3px}
.md p{font-size:13px;color:var(--mut);font-family:'Quicksand',sans-serif;margin-bottom:17px}
.ma{display:flex;gap:9px}
.ma button{flex:1;padding:11px;border-radius:10px;font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;cursor:pointer;border:none}
/* avatar picker */
.ag{display:flex;gap:7px;flex-wrap:wrap;margin-top:5px}
.av{width:46px;height:46px;border-radius:11px;border:2.5px solid #e2e8f0;display:flex;align-items:center;justify-content:center;font-size:23px;cursor:pointer;transition:all .2s;background:#f8fafc}
.av:hover{border-color:var(--mint);transform:scale(1.08)}.av.on{border-color:var(--yel);background:#fffbeb;transform:scale(1.1)}
/* big avatar preview */
.bigAv{width:78px;height:78px;border-radius:18px;background:#dbeafe;display:flex;align-items:center;justify-content:center;font-size:42px;flex-shrink:0;border:2px solid #e2e8f0;transition:transform .25s cubic-bezier(.2,.8,.2,1)}
.bigAv.pop{transform:scale(1.12)}
/* theme toggle (Aparência) */
.th-grp{display:flex;gap:6px;padding:4px;background:#f1f5f9;border-radius:12px;margin-top:5px}
.th-btn{flex:1;padding:11px;border:none;background:transparent;border-radius:9px;cursor:pointer;font-family:'Outfit',sans-serif;font-weight:600;font-size:13px;color:#64748b;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .15s}
.th-btn:hover{color:#0f172a}
.th-btn.on{background:white;color:#012C56;box-shadow:0 1px 2px rgba(0,0,0,.05),0 1px 3px rgba(0,0,0,.08)}
.th-btn svg{width:16px;height:16px;flex-shrink:0}
/* ═══ DARK MODE — scoped to body.dark ═══ */
body.dark #PA.on{background:#0a1426}
body.dark .pm{background:#0a1426}
body.dark .pt,body.dark .st,body.dark .scv,body.dark .cn,body.dark .iname,body.dark .att,body.dark .bn,body.dark .cin,body.dark .ceti{color:#e2e8f0}
