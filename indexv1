function initDiag() {
  diagA = []; curQ = 0;
  document.getElementById('dCard').style.display = 'block';
  document.getElementById('dRes').style.display = 'none';
  document.getElementById('dCount').style.display = '';
  document.getElementById('dDots').style.display = 'flex';
  renderQ();
}

function renderQ() {
  const q = Qs[curQ];
  document.getElementById('dCount').textContent = 'Pergunta ' + (curQ+1) + ' de ' + Qs.length;
  // dots
  const dots = document.getElementById('dDots');
  dots.innerHTML = Qs.map((_,i) =>
    `<div style="height:8px;border-radius:4px;background:${i<curQ?'#71C8C0':i===curQ?'white':'rgba(255,255,255,.3)'};width:${i===curQ?24:8}px;transition:all .3s"></div>`
  ).join('');
  document.getElementById('dEmo').textContent = q.e;
  document.getElementById('dQ').textContent = q.q;
  document.getElementById('dOpts').innerHTML = q.opts.map((o,i) =>
    `<button class="dopt" onclick="diagAns(${i})"><span class="dlet">${'ABCD'[i]}</span><span>${o}</span></button>`
  ).join('');
  document.getElementById('dBack').style.display = curQ > 0 ? 'block' : 'none';
  // re-trigger entry animation
  const card = document.getElementById('dCard');
  card.classList.remove('diag-anim'); void card.offsetWidth; card.classList.add('diag-anim');
}

function diagAns(idx) {
  document.querySelectorAll('.dopt').forEach((b,i) => {
    b.disabled = true;
    if(i===idx) b.classList.add('sel');
    else b.classList.add('dim');
  });
  diagA[curQ] = Qs[curQ].sc[idx];
  setTimeout(() => {
    curQ++;
    if (curQ < Qs.length) { renderQ(); }
    else { showRes(); }
  }, 600);
}

function diagBack(){
  if(curQ === 0) return;
  curQ--;
  diagA.length = curQ;
  renderQ();
}

function showRes() {
  const total = diagA.reduce((a,b)=>a+b,0);
  const pct = total / (Qs.length * 3);
  cLvl = pct < 0.33 ? 0 : pct < 0.66 ? 1 : 2;
  const lv = Lvs[cLvl];
  document.getElementById('dCard').style.display = 'none';
  document.getElementById('dCount').style.display = 'none';
  document.getElementById('dDots').style.display = 'none';
  const res = document.getElementById('dRes');
  res.style.display = 'block';
  res.classList.remove('diag-anim'); void res.offsetWidth; res.classList.add('diag-anim');
  document.getElementById('rEmo').textContent = lv.e;
  document.getElementById('rT').textContent = lv.t;
  document.getElementById('rD').textContent = lv.d;
  document.getElementById('rIs').innerHTML = `<div style="background:#eff6ff;border-radius:11px;padding:10px 16px;font-size:13px;font-weight:700;color:#1e40af;display:inline-block">🏝️ Ilha Principal desbloqueada</div>`;
}



