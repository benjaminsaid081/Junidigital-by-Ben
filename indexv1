// ── MAP PAN (transform-based — funciona nos dois eixos, em qualquer ecrã) ─────
const VBW = 1330, VBH = 900;        // janela visível (viewBox)
const WORLD_W = 1760, WORLD_H = 1280; // dimensão total do mundo (até às ilhas mais distantes)
let mapPan = { x: 0, y: 0 };

function applyMapPan(){
  const wg = document.getElementById('worldGroup');
  if(wg) wg.setAttribute('transform', 'translate(' + mapPan.x + ',' + mapPan.y + ')');
}

function clampMapPan(){
  const svg = document.getElementById('isoMap');
  let visW = VBW, visH = VBH;
  if(svg){
    const r = svg.getBoundingClientRect();
    if(r.width > 0 && r.height > 0){
      // preserveAspectRatio=slice => escala = maior rácio; área visível = container/escala
      const scale = Math.max(r.width / VBW, r.height / VBH);
      visW = r.width / scale;
      visH = r.height / scale;
    }
  }
  const minX = Math.min(0, visW - WORLD_W);
  const minY = Math.min(0, visH - WORLD_H);
  mapPan.x = Math.max(minX, Math.min(0, mapPan.x));
  mapPan.y = Math.max(minY, Math.min(0, mapPan.y));
}

(function setupMapPan(){
  const init = () => {
    const c = document.getElementById('mapPan');
    const svg = document.getElementById('isoMap');
    const hint = document.getElementById('panHint');
    if(!c || !svg) return;
    let down = false, sx = 0, sy = 0, px = 0, py = 0, moved = 0, hintGone = false;

    const hideHint = () => {
      if(hintGone || !hint) return;
      hintGone = true;
      hint.style.opacity = '0';
      setTimeout(() => { if(hint) hint.style.display = 'none'; }, 500);
    };
    const vbScale = () => {
      const r = svg.getBoundingClientRect();
      return Math.max(r.width / VBW, r.height / VBH) || 1;
    };
    const start = (cx,cy) => {
      down = true; moved = 0;
      sx = cx; sy = cy; px = mapPan.x; py = mapPan.y;
      c.style.cursor = 'grabbing';
    };
    const move = (cx,cy) => {
      if(!down) return;
      const s = vbScale();
      moved = Math.max(moved, Math.abs(cx-sx) + Math.abs(cy-sy));
      mapPan.x = px + (cx - sx) / s;
      mapPan.y = py + (cy - sy) / s;
      clampMapPan();
      applyMapPan();
      if(moved > 5) hideHint();
    };
    const end = () => {
      if(!down) return;
      down = false;
      c.style.cursor = 'grab';
      if(moved > 5){ _mapDragged = true; setTimeout(() => { _mapDragged = false; }, 30); }
    };

    c.addEventListener('mousedown', e => { if(e.button!==0) return; start(e.clientX,e.clientY); e.preventDefault(); });
    window.addEventListener('mousemove', e => move(e.clientX,e.clientY));
    window.addEventListener('mouseup', end);
    c.addEventListener('touchstart', e => { if(e.touches.length===1) start(e.touches[0].clientX,e.touches[0].clientY); }, {passive:true});
    c.addEventListener('touchmove', e => { if(e.touches.length===1) move(e.touches[0].clientX,e.touches[0].clientY); }, {passive:true});
    c.addEventListener('touchend', end);
    setTimeout(hideHint, 4000);
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();

