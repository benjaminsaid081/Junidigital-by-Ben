function gS(n) {
  ['s1','s2','s3','sOk'].forEach(id => { const e=document.getElementById(id); if(e) e.classList.remove('on'); });
  const t = n==='Ok' ? 'sOk' : 's'+n;
  const el = document.getElementById(t);
  if (el) el.classList.add('on');
}

function vS2() {
  const email = document.getElementById('rem').value.trim();
  const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  document.getElementById('eErr').classList.toggle('on', !ok);
  document.getElementById('rem').classList.toggle('er', !ok);
  if (ok) gS(3);
}

function chkP() {
  const pw = document.getElementById('pw').value;
  const s = (pw.length>=8?1:0)+(/[A-Z]/.test(pw)?1:0)+(/\d/.test(pw)?1:0)+(/[^A-Za-z0-9]/.test(pw)?1:0);
  const cols = ['#e2e8f0','#ef4444','#f59e0b','#3b82f6','#22c55e'];
  const lbls = ['','Fraca','Razoável','Boa','Muito forte'];
  for(let i=1;i<=4;i++) document.getElementById('pb'+i).style.background = i<=s ? cols[s] : '#e2e8f0';
  document.getElementById('pl').textContent = s ? 'Segurança: '+lbls[s] : '';
}

function vS3() {
  const pw = document.getElementById('pw').value;
  const pw2 = document.getElementById('pw2').value;
  let ok = true;
  if (pw.length < 8) { document.getElementById('pErr').classList.add('on'); document.getElementById('pw').classList.add('er'); ok=false; }
  else { document.getElementById('pErr').classList.remove('on'); document.getElementById('pw').classList.remove('er'); }
  if (pw !== pw2) { document.getElementById('p2Err').classList.add('on'); document.getElementById('pw2').classList.add('er'); ok=false; }
  else { document.getElementById('p2Err').classList.remove('on'); document.getElementById('pw2').classList.remove('er'); }
  if (!ok) return;
  uName = document.getElementById('fn').value || 'Utilizador';
  document.getElementById('wN').textContent = uName;
  document.getElementById('wM').textContent = role==='enc'
    ? 'Conta criada! Podes adicionar os teus filhos e acompanhar o progresso.'
    : 'Conta criada! Podes criar turmas e personalizar os desafios.';
  document.getElementById('wI').textContent = role==='enc' ? '👪' : '🏫';
  document.getElementById('wR').textContent = role==='enc' ? 'Enc. de Educação' : 'Professor';
  gS('Ok');
}

function togP(id, btn) {
  const el = document.getElementById(id);
  el.type = el.type==='text' ? 'password' : 'text';
  btn.textContent = el.type==='text' ? '🙈' : '👁';
}

function setLoginMode(m){
  loginMode = m;
  const tabs = document.querySelectorAll('#loginTabs button');
  tabs[0].classList.toggle('on', m==='child');
  tabs[1].classList.toggle('on', m==='adult');
  const inp = document.getElementById('le');
  const lab = document.getElementById('leLab');
  const adultOnly = document.getElementById('adultOnly');
  const forgot = document.getElementById('forgotWrap');
  const hint = document.getElementById('loginHint');
  if(m==='child'){
    lab.textContent = 'Nome de utilizador ou turma';
    inp.type = 'text';
    inp.placeholder = 'maria_silva, user1 ou 6A...';
    inp.value = '';
    inp.setAttribute('autocomplete','username');
    adultOnly.style.display = 'none';
    forgot.style.display = 'none';
    hint.innerHTML = 'Testa: <strong>maria</strong> · <strong>user1</strong> · <strong>6A</strong><br>password: qualquer coisa';
  } else {
    lab.textContent = 'Email';
    inp.type = 'email';
    inp.placeholder = 'email@exemplo.pt';
    inp.value = '';
    inp.setAttribute('autocomplete','email');
    adultOnly.style.display = '';
    forgot.style.display = '';
    hint.innerHTML = 'Testa: <strong>prof@test.pt</strong> · <strong>pai@test.pt</strong><br>password: qualquer coisa';
  }
  document.getElementById('lErr').classList.remove('on');
